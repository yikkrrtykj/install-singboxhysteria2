                  "$ref": "#/components/schemas/AuthContext"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/AccessError"
          },
          "429": {
            "$ref": "#/components/responses/RateLimitError"
          }
        }
      }
    },
