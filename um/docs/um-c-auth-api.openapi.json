{
  "openapi": "3.0.3",
  "info": {
    "title": "UM-C Web authentication and administration API (Draft)",
    "version": "0.1.0-draft",
    "description": "Browser-plane API served by the center Web listener. Every route except GET /api/health requires a valid Cloudflare Access assertion; mutations additionally require a per-session X-CSRF-Token. This is an isolated lab/deployment-template contract, not a production authorization. The existing B4 /api/v1/* contract is referenced separately."
  },
  "servers": [
    {
      "url": "https://localhost:8092",
      "description": "Loopback origin reached through Cloudflare Tunnel/Access (placeholder)"
    }
  ],
  "security": [
    {
      "CloudflareAccess": []
    }
  ],
  "tags": [
    {
      "name": "auth",
      "description": "Local login, TOTP, recovery and session lifecycle"
    },
    {
      "name": "account",
      "description": "Authenticated account security"
    },
    {
      "name": "users",
      "description": "platform_admin account administration"
    },
    {
      "name": "b4",
      "description": "Existing B4 management API through the Web session bridge"
    },
    {
      "name": "health",
      "description": "Minimal anonymous Web health"
    },
    {
      "name": "traffic",
      "description": "Bounded read-only normalized traffic observation queries (observation_lower_bound data; observed_at is the traffic clock)"
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Minimal Web health probe",
        "security": [],
        "responses": {
          "200": {
            "description": "Service is listening",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
