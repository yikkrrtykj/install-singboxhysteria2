{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://um.invalid/contracts/v1/report-snapshot.schema.json",
  "title": "UM v1 report body: snapshot (latest state, idempotent upsert, nullable unknown data; revision 5 adds Windows terminal telemetry)",
  "description": "The optional `terminal` object is valid only for a windows_terminal node. A windows_terminal node MUST send it when the terminal source is configured; the base system/services/protocols/traffic/clients fields stay in their honest unavailable/null/empty state. A linux_vps node MUST NOT send `terminal` (platform_mismatch).",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "type", "report_id", "collected_at", "agent", "host",
               "availability", "counter_epoch", "system", "services", "protocols",
               "traffic", "clients"],
  "properties": {
    "v": {"const": 1},
    "type": {"const": "snapshot"},
    "report_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "collected_at": {"type": "integer", "minimum": 0, "maximum": 1000000000000},
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "uptime_s"],
      "properties": {
        "version": {"type": "string", "maxLength": 32,
                    "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"},
        "uptime_s": {"type": "integer", "minimum": 0, "maximum": 1000000000000}
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "kernel", "arch"],
      "properties": {
        "os": {"enum": ["linux", "windows"]},
        "kernel": {"type": "string", "maxLength": 64, "pattern": "^[0-9A-Za-z.+-]+$"},
        "arch": {"enum": ["amd64", "arm64"]}
      }
    },
    "availability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "services", "protocols", "traffic", "clients"],
      "properties": {
        "system": {"enum": ["ok", "partial", "unavailable"]},
        "services": {"enum": ["ok", "partial", "unavailable"]},
        "protocols": {"enum": ["ok", "partial", "unavailable"]},
        "traffic": {"enum": ["ok", "partial", "unavailable"]},
        "clients": {"enum": ["ok", "partial", "unavailable"]}
      }
    },
    "counter_epoch": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu_pct", "load1", "mem_total_bytes", "mem_used_bytes",
                   "disk_total_bytes", "disk_used_bytes", "net_rx_bytes", "net_tx_bytes"],
      "properties": {
        "cpu_pct": {"oneOf": [{"type": "number", "minimum": 0, "exclusiveMaximum": 10000}, {"type": "null"}]},
        "load1": {"oneOf": [{"type": "number", "minimum": 0, "exclusiveMaximum": 100000}, {"type": "null"}]},
        "mem_total_bytes": {"oneOf": [{"type": "integer", "minimum": 1, "maximum": 1099511627776}, {"type": "null"}]},
        "mem_used_bytes": {"oneOf": [{"type": "integer", "minimum": 0, "maximum": 1099511627776}, {"type": "null"}]},
        "disk_total_bytes": {"oneOf": [{"type": "integer", "minimum": 1, "maximum": 1099511627776}, {"type": "null"}]},
        "disk_used_bytes": {"oneOf": [{"type": "integer", "minimum": 0, "maximum": 1099511627776}, {"type": "null"}]},
        "net_rx_bytes": {"oneOf": [{"type": "integer", "minimum": 0, "maximum": 9007199254740991}, {"type": "null"}]},
        "net_tx_bytes": {"oneOf": [{"type": "integer", "minimum": 0, "maximum": 9007199254740991}, {"type": "null"}]}
      }
    },
    "services": {
      "type": "array", "minItems": 0, "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "state"],
        "properties": {
          "name": {"type": "string", "maxLength": 64,
                   "pattern": "^[a-z0-9][a-z0-9._-]*$"},
          "state": {"enum": ["active", "inactive", "failed", "unknown"]}
        }
      }
    },
    "protocols": {
      "type": "array", "minItems": 0, "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "inbound_tag", "state", "reason", "observed_at"],
        "properties": {
          "kind": {"enum": ["reality", "hysteria2", "other"]},
          "inbound_tag": {"type": "string", "maxLength": 64,
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
          "state": {"enum": ["up", "down", "unknown"]},
          "reason": {"enum": ["ok", "timeout", "tls_failed", "auth_failed",
                              "service_inactive", "source_unavailable", "unavailable",
                              "unknown"]},
          "observed_at": {"type": "integer", "minimum": 0, "maximum": 1000000000000}
        }
      }
    },
    "traffic": {
      "type": "array", "minItems": 0, "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scope", "inbound_tag", "uplink_total_bytes", "downlink_total_bytes"],
        "properties": {
          "scope": {"const": "protocol"},
          "inbound_tag": {"type": "string", "maxLength": 64,
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
          "uplink_total_bytes": {"oneOf": [{"type": "integer", "minimum": 0, "maximum": 9007199254740991}, {"type": "null"}]},
          "downlink_total_bytes": {"oneOf": [{"type": "integer", "minimum": 0, "maximum": 9007199254740991}, {"type": "null"}]}
        }
      }
    },
    "clients": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active", "tracked", "summaries"],
      "properties": {
        "active": {"oneOf": [{"type": "integer", "minimum": 0, "maximum": 1000000}, {"type": "null"}]},
        "tracked": {"oneOf": [{"type": "integer", "minimum": 0, "maximum": 1000000}, {"type": "null"}]},
        "summaries": {
          "type": "array", "minItems": 0, "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["device_ref", "active", "uplink_bytes", "downlink_bytes", "last_seen"],
            "properties": {
              "device_ref": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"},
              "active": {"type": "integer", "minimum": 0, "maximum": 1000},
              "uplink_bytes": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
              "downlink_bytes": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
              "last_seen": {"type": "integer", "minimum": 0, "maximum": 1000000000000}
            }
          }
        }
      }
    },
    "terminal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selection", "active_connections"],
      "properties": {
        "selection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["availability", "sampled_at", "route", "reason_code"],
          "properties": {
            "availability": {"enum": ["ok", "partial", "unavailable"]},
            "sampled_at": {"type": "integer", "minimum": 0, "maximum": 1000000000000},
            "route": {
              "description": "Current selected leaf mapped to exactly one local route token; null means not resolvable. Unmapped/ambiguous paths are never reported as DIRECT.",
              "oneOf": [
                {"$ref": "#/$defs/route_token"},
                {"type": "null"}
              ]
            },
            "reason_code": {
              "oneOf": [
                {"$ref": "#/$defs/terminal_reason_code"},
                {"type": "null"}
              ]
            }
          }
        },
        "active_connections": {
          "type": "object",
          "additionalProperties": false,
          "required": ["availability", "sampled_at", "total", "by_route"],
          "properties": {
            "availability": {"enum": ["ok", "partial", "unavailable"]},
            "sampled_at": {"type": "integer", "minimum": 0, "maximum": 1000000000000},
            "total": {
              "oneOf": [
                {"type": "integer", "minimum": 0, "maximum": 1000000},
                {"type": "null"}
              ]
            },
            "by_route": {
              "type": "object",
              "additionalProperties": false,
              "required": ["a_reality", "a_hy2", "b_reality", "b_hy2", "direct", "unknown"],
              "properties": {
                "a_reality": {"oneOf": [{"type": "integer", "minimum": 0, "maximum": 1000000}, {"type": "null"}]},
                "a_hy2": {"oneOf": [{"type": "integer", "minimum": 0, "maximum": 1000000}, {"type": "null"}]},
                "b_reality": {"oneOf": [{"type": "integer", "minimum": 0, "maximum": 1000000}, {"type": "null"}]},
                "b_hy2": {"oneOf": [{"type": "integer", "minimum": 0, "maximum": 1000000}, {"type": "null"}]},
                "direct": {"oneOf": [{"type": "integer", "minimum": 0, "maximum": 1000000}, {"type": "null"}]},
                "unknown": {"oneOf": [{"type": "integer", "minimum": 0, "maximum": 1000000}, {"type": "null"}]}
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "route_token": {
      "description": "Exactly six tokens, aligned with the existing windowsobs role enum; center aggregates A={a_reality,a_hy2}, B={b_reality,b_hy2} and keeps protocol drill-down.",
      "enum": ["a_reality", "a_hy2", "b_reality", "b_hy2", "direct", "unknown"]
    },
    "terminal_reason_code": {
      "enum": [
        "controller_unreachable",
        "controller_auth",
        "malformed_response",
        "route_unbound",
        "source_authorization_unproven"
      ]
    }
  }
}
