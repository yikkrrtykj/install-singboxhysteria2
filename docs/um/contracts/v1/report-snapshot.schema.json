{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://um.invalid/contracts/v1/report-snapshot.schema.json",
  "title": "UM v1 report body: snapshot (latest state, idempotent upsert)",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "type", "generated_at", "config_version", "agent", "host",
               "counter_epoch", "system", "services", "protocols", "traffic", "clients"],
  "properties": {
    "v": {"const": 1},
    "type": {"const": "snapshot"},
    "generated_at": {"type": "integer", "minimum": 0, "maximum": 1000000000000},
    "config_version": {"type": "integer", "minimum": 1},
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "boot_id", "uptime_s"],
      "properties": {
        "version": {"type": "string", "maxLength": 32,
                    "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"},
        "boot_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
        "uptime_s": {"type": "integer", "minimum": 0, "maximum": 1000000000000}
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "kernel", "arch"],
      "properties": {
        "os": {"const": "linux"},
        "kernel": {"type": "string", "maxLength": 64, "pattern": "^[0-9A-Za-z.+-]+$"},
        "arch": {"enum": ["amd64", "arm64"]}
      }
    },
    "counter_epoch": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu_pct", "load1", "mem_total_bytes", "mem_used_bytes",
                   "disk_total_bytes", "disk_used_bytes", "net_rx_bytes", "net_tx_bytes"],
      "properties": {
        "cpu_pct": {"type": "number", "minimum": 0, "maximum": 10000},
        "load1": {"type": "number", "minimum": 0, "maximum": 100000},
        "mem_total_bytes": {"type": "integer", "minimum": 1, "maximum": 1099511627776},
        "mem_used_bytes": {"type": "integer", "minimum": 0, "maximum": 1099511627776},
        "disk_total_bytes": {"type": "integer", "minimum": 1, "maximum": 1099511627776},
        "disk_used_bytes": {"type": "integer", "minimum": 0, "maximum": 1099511627776},
        "net_rx_bytes": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "net_tx_bytes": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
      }
    },
    "services": {
      "type": "array", "minItems": 0, "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "state"],
        "properties": {
          "name": {"type": "string", "maxLength": 64,
                   "pattern": "^[a-z0-9][a-z0-9._-]*$"},
          "state": {"enum": ["active", "inactive", "failed", "unknown"]}
        }
      }
    },
    "protocols": {
      "type": "array", "minItems": 0, "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "inbound_tag", "state", "reason", "observed_at"],
        "properties": {
          "kind": {"enum": ["reality", "hysteria2", "other"]},
          "inbound_tag": {"type": "string", "maxLength": 64,
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
          "state": {"enum": ["up", "down", "unknown"]},
          "reason": {"enum": ["ok", "timeout", "tls_failed", "auth_failed",
                              "service_inactive", "source_unavailable", "unavailable",
                              "unknown"]},
          "observed_at": {"type": "integer", "minimum": 0, "maximum": 1000000000000}
        }
      }
    },
    "traffic": {
      "type": "array", "minItems": 0, "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scope", "inbound_tag", "uplink_total_bytes", "downlink_total_bytes"],
        "properties": {
          "scope": {"const": "protocol"},
          "inbound_tag": {"type": "string", "maxLength": 64,
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
          "uplink_total_bytes": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
          "downlink_total_bytes": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
        }
      }
    },
    "clients": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active", "tracked", "summaries"],
      "properties": {
        "active": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "tracked": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "summaries": {
          "type": "array", "minItems": 0, "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["device_ref", "active", "uplink_bytes", "downlink_bytes", "last_seen"],
            "properties": {
              "device_ref": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"},
              "active": {"type": "integer", "minimum": 0, "maximum": 1000},
              "uplink_bytes": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
              "downlink_bytes": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
              "last_seen": {"type": "integer", "minimum": 0, "maximum": 1000000000000}
            }
          }
        }
      }
    }
  }
}
