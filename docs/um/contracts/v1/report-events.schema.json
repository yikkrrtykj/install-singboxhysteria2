{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://um.invalid/contracts/v1/report-events.schema.json",
  "title": "UM v1 report body: bounded fault/agent event timeline",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "type", "generated_at", "events"],
  "properties": {
    "v": {"const": 1},
    "type": {"const": "events"},
    "generated_at": {"type": "integer", "minimum": 0, "maximum": 1000000000000},
    "events": {
      "type": "array", "minItems": 1, "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event_id", "at", "kind", "severity", "detail"],
        "properties": {
          "event_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "at": {"type": "integer", "minimum": 0, "maximum": 1000000000000},
          "kind": {"enum": ["service_restart", "service_failure", "protocol_outage",
                            "protocol_recovery", "agent_started", "agent_error",
                            "config_update", "clock_skew", "spool_overflow"]},
          "severity": {"enum": ["info", "warning", "critical"]},
          "detail": {
            "type": "object",
            "maxProperties": 8,
            "additionalProperties": {
              "oneOf": [
                {"type": "boolean"},
                {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991},
                {"type": "number"},
                {"type": "string", "maxLength": 64}
              ]
            }
          }
        }
      }
    }
  }
}
