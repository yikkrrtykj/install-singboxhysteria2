{
  "v": 1,
  "contract": "um-v1",
  "description": "Behavioural negative cases for the UM v1 wire contract. These are HTTP-level expectations; the signed cryptographic cases are in test-vectors.v1.json.",
  "cases": [
    {
      "id": "NEG-ENROLL-01",
      "endpoint": "/v1/agent/enroll",
      "mutation": "bootstrap token never issued",
      "expected": {
        "http": 401,
        "error": "token_invalid",
        "retryable": false
      }
    },
    {
      "id": "NEG-ENROLL-02",
      "endpoint": "/v1/agent/enroll",
      "mutation": "bootstrap token expired (TTL > 15 min)",
      "expected": {
        "http": 401,
        "error": "token_expired",
        "retryable": false
      }
    },
    {
      "id": "NEG-ENROLL-03",
      "endpoint": "/v1/agent/enroll",
      "mutation": "bootstrap token already consumed",
      "expected": {
        "http": 401,
        "error": "token_used",
        "retryable": false
      }
    },
    {
      "id": "NEG-ENROLL-04",
      "endpoint": "/v1/agent/enroll",
      "mutation": "body contains a signature field (signature must be header-only)",
      "expected": {
        "http": 400,
        "error": "invalid_request",
        "retryable": false
      }
    },
    {
      "id": "NEG-ENROLL-05",
      "endpoint": "/v1/agent/enroll",
      "mutation": "X-UM-Pubkey does not match the key that signed the request",
      "expected": {
        "http": 401,
        "error": "bad_signature",
        "retryable": false
      }
    },
    {
      "id": "NEG-ENROLL-06",
      "endpoint": "/v1/agent/enroll",
      "mutation": "request body tampered after signing",
      "expected": {
        "http": 401,
        "error": "bad_signature",
        "retryable": false
      }
    },
    {
      "id": "NEG-ENROLL-07",
      "endpoint": "/v1/agent/enroll",
      "mutation": "signed_at outside the 300 s window",
      "expected": {
        "http": 401,
        "error": "stale_timestamp",
        "retryable": true
      }
    },
    {
      "id": "NEG-ENROLL-08",
      "endpoint": "/v1/agent/enroll",
      "mutation": "duplicate X-UM-Nonce header",
      "expected": {
        "http": 400,
        "error": "duplicate_header",
        "retryable": false
      }
    },
    {
      "id": "NEG-ENROLL-09",
      "endpoint": "/v1/agent/enroll",
      "mutation": "missing X-UM-Content-Encoding (identity must be explicit)",
      "expected": {
        "http": 400,
        "error": "missing_header",
        "retryable": false
      }
    },
    {
      "id": "NEG-ENROLL-10",
      "endpoint": "/v1/agent/enroll",
      "mutation": "stacked or non-gzip content encoding",
      "expected": {
        "http": 400,
        "error": "unsupported_encoding",
        "retryable": false
      }
    },
    {
      "id": "NEG-REPORT-01",
      "endpoint": "/v1/agent/report",
      "mutation": "signature created for /v1/agent/rotate reused on /v1/agent/report",
      "expected": {
        "http": 401,
        "error": "bad_signature",
        "retryable": false
      }
    },
    {
      "id": "NEG-REPORT-02",
      "endpoint": "/v1/agent/report",
      "mutation": "same X-UM-Nonce reused with a different body",
      "expected": {
        "http": 409,
        "error": "nonce_reuse",
        "retryable": false
      }
    },
    {
      "id": "NEG-REPORT-03",
      "endpoint": "/v1/agent/report",
      "mutation": "same report_id resent with different body bytes",
      "expected": {
        "http": 409,
        "error": "report_conflict",
        "retryable": false
      }
    },
    {
      "id": "NEG-REPORT-04",
      "endpoint": "/v1/agent/report",
      "mutation": "report from a retired boot_id after a newer boot was accepted",
      "expected": {
        "http": 409,
        "error": "stale_boot",
        "retryable": false
      }
    },
    {
      "id": "NEG-REPORT-05",
      "endpoint": "/v1/agent/report",
      "mutation": "seq lower than last accepted seq on the current boot",
      "expected": {
        "http": 409,
        "error": "sequence_conflict",
        "retryable": false
      }
    },
    {
      "id": "NEG-REPORT-06",
      "endpoint": "/v1/agent/report",
      "mutation": "declared Content-Encoding gzip but body is not one gzip member",
      "expected": {
        "http": 400,
        "error": "unsupported_encoding",
        "retryable": false
      }
    },
    {
      "id": "NEG-REPORT-07",
      "endpoint": "/v1/agent/report",
      "mutation": "decoded body above the 128 KiB cap / compressed body above 256 KiB",
      "expected": {
        "http": 413,
        "error": "payload_too_large",
        "retryable": false
      }
    },
    {
      "id": "NEG-REPORT-08",
      "endpoint": "/v1/agent/report",
      "mutation": "duplicate X-UM-Signature or X-UM-Node-Id header",
      "expected": {
        "http": 400,
        "error": "duplicate_header",
        "retryable": false
      }
    },
    {
      "id": "NEG-REPORT-09",
      "endpoint": "/v1/agent/report",
      "mutation": "collected_at in the future (> sent_at + 60 s)",
      "expected": {
        "http": 400,
        "error": "invalid_request",
        "retryable": false
      }
    },
    {
      "id": "NEG-REPORT-10",
      "endpoint": "/v1/agent/report",
      "mutation": "payload sent with sent_at outside the 300 s window while collected_at is old",
      "expected": {
        "http": 401,
        "error": "stale_timestamp",
        "retryable": true
      }
    },
    {
      "id": "NEG-ROT-01",
      "endpoint": "/v1/agent/rotate",
      "mutation": "rotate retried after the old key grace expired",
      "expected": {
        "http": 401,
        "error": "revoked_key",
        "retryable": false
      }
    },
    {
      "id": "NEG-ROT-02",
      "endpoint": "/v1/agent/rotate",
      "mutation": "rotate body signs with the new key instead of the old key",
      "expected": {
        "http": 401,
        "error": "bad_signature",
        "retryable": false
      }
    },
    {
      "id": "NEG-GEN-01",
      "endpoint": "/v1/agent/config",
      "mutation": "report signature reused on config endpoint",
      "expected": {
        "http": 401,
        "error": "bad_signature",
        "retryable": false
      }
    },
    {
      "id": "NEG-GEN-02",
      "endpoint": "/api/v1/*",
      "mutation": "node identity/signature headers sent to the web admin listener",
      "expected": {
        "http": 404,
        "error": "endpoint_not_found",
        "retryable": false
      }
    },
    {
      "id": "NEG-GEN-03",
      "endpoint": "/v1/agent/*",
      "mutation": "admin session cookie sent to the ingest listener",
      "expected": {
        "http": 401,
        "error": "missing_header",
        "retryable": false
      }
    },
    {
      "id": "NEG-ENROLL-11",
      "endpoint": "/v1/agent/enroll",
      "mutation": "enrollment transaction committed but response lost; retry with the used token",
      "expected": {
        "http": 401,
        "error": "token_used",
        "retryable": false,
        "recovery": "admin revokes orphan active node and issues a new token"
      }
    },
    {
      "id": "NEG-ROT-03",
      "endpoint": "/v1/agent/rotate",
      "mutation": "same nonce+body retried while awaiting proof",
      "expected": {
        "http": 200,
        "error": null,
        "recovery": "identical rotate-response replayed from persisted rotation record"
      }
    },
    {
      "id": "NEG-ROT-04",
      "endpoint": "/v1/agent/rotate",
      "mutation": "different nonce while a rotation is awaiting proof",
      "expected": {
        "http": 409,
        "error": "rotation_in_progress",
        "retryable": false
      }
    },
    {
      "id": "NEG-ROT-05",
      "endpoint": "/v1/agent/rotate",
      "mutation": "retry after awaiting-proof deadline expired (rotation aborted)",
      "expected": {
        "http": 409,
        "error": "rotation_expired",
        "retryable": false,
        "recovery": "agent deletes provisional key, resumes old-key reporting"
      }
    },
    {
      "id": "NEG-ROT-06",
      "endpoint": "/v1/agent/report",
      "mutation": "old key used after rotation confirmed (new-key proof accepted)",
      "expected": {
        "http": 401,
        "error": "revoked_key",
        "retryable": false,
        "recovery": "agent switches to confirmed new key; operator recovery only if no key proves valid"
      }
    },
    {
      "id": "NEG-REPORT-11",
      "endpoint": "/v1/agent/report",
      "mutation": "seq == last_seq with an identical request fingerprint (lost ACK retry)",
      "expected": {
        "http": 200,
        "error": null,
        "ack": "duplicate"
      }
    },
    {
      "id": "NEG-REPORT-12",
      "endpoint": "/v1/agent/report",
      "mutation": "seq == last_seq with a different request fingerprint",
      "expected": {
        "http": 409,
        "error": "sequence_conflict",
        "retryable": false
      }
    },
    {
      "id": "NEG-REPORT-13",
      "endpoint": "/v1/agent/report",
      "mutation": "nonce previously used on another endpoint (fingerprint differs)",
      "expected": {
        "http": 409,
        "error": "nonce_reuse",
        "retryable": false
      }
    },
    {
      "id": "NEG-REPORT-14",
      "endpoint": "/v1/agent/report",
      "mutation": "boot_id is not the persisted current boot (even if absent from bounded boot_registry history)",
      "expected": {
        "http": 409,
        "error": "stale_boot",
        "retryable": false
      }
    },
    {
      "id": "NEG-REPORT-15",
      "endpoint": "/v1/agent/report",
      "mutation": "valid signed report whose source is authorization-unproven/disabled in agent config",
      "expected": {
        "http": 400,
        "error": "invalid_request",
        "retryable": false,
        "recovery": "source remains disabled; availability unavailable; no fabricated data"
      }
    }
  ]
}
