{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://um.invalid/contracts/v1/agent-config.schema.json",
  "title": "UM v1 pulled agent configuration response",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "node_id", "event_id", "config_version", "cadence_seconds",
               "collect", "device_salt", "server_time"],
  "properties": {
    "v": {"const": 1},
    "node_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "event_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "config_version": {"type": "integer", "minimum": 1},
    "cadence_seconds": {"type": "integer", "minimum": 30, "maximum": 300},
    "collect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "services", "protocols", "traffic", "clients", "events"],
      "properties": {
        "system": {"type": "boolean"},
        "services": {"type": "boolean"},
        "protocols": {"type": "boolean"},
        "traffic": {"type": "boolean"},
        "clients": {"type": "boolean"},
        "events": {"type": "boolean"}
      }
    },
    "device_salt": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"},
    "server_time": {"type": "integer", "minimum": 0}
  }
}
