{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://um.invalid/contracts/v1/enroll-request.schema.json",
  "title": "UM v1 enrollment request body (signature is a transport header, not a body field)",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "agent_version", "host", "capabilities"],
  "properties": {
    "v": {"const": 1},
    "agent_version": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "kernel", "arch"],
      "properties": {
        "os": {"const": "linux"},
        "kernel": {"type": "string", "maxLength": 64, "pattern": "^[0-9A-Za-z.+-]+$"},
        "arch": {"enum": ["amd64", "arm64"]}
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 0,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {"enum": ["metrics_v1", "events_v1", "rotate_v1", "config_v1"]}
    }
  }
}
