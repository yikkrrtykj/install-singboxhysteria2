  "max_boot_gap": 65535,
  "rules": [
    "Every successful start of an enrolled runtime, including unclean exit or power-loss recovery, increments generation by exactly one and generates a new 32-hex boot id, fsynced before network activity.",
    "status/inspection/read-only local CLI operations are not restarts and must not mutate generation, boot state, spool or quarantine.",
    "Same-runtime transport retry may replay the exact persisted generation/boot/seq/sent_at/nonce/fingerprint attempt; the center may return duplicate.",
    "Restart replay preserves report_id/collected_at/type/body identity but uses the new generation/boot and a fresh valid attempt; no retired sequence is reused.",
    "The first new-generation replay may be duplicate, but it must atomically advance the new generation/boot/seq high-water with report_id dedupe and write no second data copy.",
    "A late retired-generation request is stale_boot_generation; same-generation different boot id is boot_identity_conflict; gap > MAX_BOOT_GAP is boot_identity_conflict.",
    "No weakening of signature, nonce, request fingerprint, report_id dedupe, boot high-water, generation gap bounds, revocation, rotation proof or fsync-before-send is permitted.",
    "next_seq exhaustion on a duplicate first contact is still bound by the frozen exhaustion rules; no seq wrap or reuse."
  ],
  "old_rec27_mapping": {
    "old_center_exact_duplicate": "AMEND-REC-27-A",
    "old_agent_side_same_generation_power_loss_resume": "SUPERSEDED by AMEND-REC-27-B",
    "old_center_rule_status": "retained"
  },
