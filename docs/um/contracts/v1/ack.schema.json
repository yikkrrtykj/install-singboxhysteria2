{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://um.invalid/contracts/v1/ack.schema.json",
  "title": "UM v1 report acknowledgement",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "result", "server_time", "next_seq", "config_version", "retry_after_s"],
  "properties": {
    "v": {"const": 1},
    "result": {"enum": ["accepted", "duplicate"]},
    "server_time": {"type": "integer", "minimum": 0},
    "next_seq": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "config_version": {"type": "integer", "minimum": 1},
    "retry_after_s": {
      "oneOf": [
        {"type": "null"},
        {"type": "integer", "minimum": 1, "maximum": 3600}
      ]
    }
  }
}
