  "max_boot_gap": 65535,
  "cases": [
    {
      "id": "REC-01",
      "slice": "UM-B1",
      "title": "在线正常重启：generation+1 首次接触 seq=1",
      "rev4_expected_failure": false,
      "setup": {
        "center": {
          "highest_gen": 4,
          "boot_id": "b4",
          "last_seq": 9
        },
        "agent": {
          "generation": 5,
          "boot_id": "b5",
          "next_seq": 1,
          "spool": [
            "r-new"
          ]
        }
      },
      "attempt": {
        "endpoint": "report",
        "gen": 5,
        "boot_id": "b5",
        "seq": 1,
        "report_id": "r-new"
      },
      "expected": {
        "http_status": 200,
        "result": "accepted",
        "center_state": {
          "highest_gen": 5,
          "boot_id": "b5",
          "last_seq": 1
        }
      },
      "rev5_status": "accepted_or_defined_by_rev-5"
    },
    {
