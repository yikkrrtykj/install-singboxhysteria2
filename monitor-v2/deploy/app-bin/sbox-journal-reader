#!/usr/bin/env bash
# sbox-journal-reader -- runtime entrypoint of singbox-journal-reader.service.
#
# PR-2A STATUS: DARK. This wrapper is installed and bash -n'd by CI but is
# referenced by NO production activation path: the unit template is only
# rendered/installed by the explicitly-named sbmon_sboxjr_* helpers, which
# install-monitor.sh never calls (statically asserted).
#
# Contract (review #46 B7):
#   * the ONLY runtime configuration surface is the unit's own
#     SBOX_JR_UNIT env var, validated strictly inside the reader
#     (fail-closed). The code tree and interpreter paths below are FIXED
#     compiled-in production constants -- no SBOXJR_* env indirection ever
#     steers which code or which python runs. Test/LIVE injection happens
#     by invoking `python3 -m journal_reader.reader` directly with an
#     explicit PYTHONPATH, never through this shim.
#   * ALL operational paths are the compiled-in defaults in
#     journal_reader/reader.py -- this shim never invents or mutates them;
#   * `sbox-journal-reader reset --from-now` is the ONLY argv form (the
#     reviewed operator source-gap reset; runbook: stop the service first,
#     root invokes via runuser -u sbox-jr);
#   * the reader's own stderr carries sanitized failure CODES only
#     ([sbjr] failure=<code>) -- this shim adds nothing to the journal.
set -Eeuo pipefail

SBJR_LIB_DIR=/usr/local/lib/singbox-journal-reader
SBJR_PYTHON3=/usr/bin/python3

if [ ! -f "$SBJR_LIB_DIR/journal_reader/reader.py" ]; then
    printf '[sbjr] failure=staged_tree_missing\n' >&2
    exit 1
fi
if [ ! -x "$SBJR_PYTHON3" ]; then
    printf '[sbjr] failure=interpreter_missing\n' >&2
    exit 1
fi

PYTHONPATH="$SBJR_LIB_DIR" exec "$SBJR_PYTHON3" -m journal_reader.reader "$@"
