[Unit]
Description=sing-box Monitor v2 (collector + local web dashboard)
# Ordering only: if sing-box fails to start, the monitor MUST NOT fail the
# boot or be blocked -- After= without Requires= still starts this unit, and
# the collector treats an unreachable stream as stale and keeps retrying.
After=network-online.target sing-box.service
Wants=network-online.target

[Service]
Type=simple
User=@SBMON_USER@
Group=@SBMON_GROUP@
# P1: the data root is passed explicitly to the entrypoint; WorkingDirectory
# is a convenience only, never the source of truth for the state path.
ExecStart=@SBMON_APP_DIR@/bin/monitor-service @SBMON_CONF@ @SBMON_STATE_ROOT@
WorkingDirectory=@SBMON_STATE_ROOT@
# P8: private-by-default runtime files (snapshots, temp copies).
UMask=0077
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s

# --- hardening: each line maps to a real need of the monitor ---
# Collector needs: connect 127.0.0.1:9091, bind 127.0.0.1:9191 (>1024),
# read /etc/singbox-monitor, write /var/lib/singbox-monitor. Nothing else.
# The S0 secret is delivered as a derived root:sboxweb 0640 copy under /etc
# by the installer (P6); these options are NOT weakened for it.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
# M0.5 (rev5 G4): ProtectSystem=strict makes the whole hierarchy read-only
# except /dev, /proc, /sys; the single writable exception is the monitor's
# own data root, re-opened explicitly below. /root/sbox and
# /var/lib/sbox-cm stay non-writable AND non-readable (ProtectHome hides
# /root; the sbox-cm runtime tree is root:root 0700 and outside the data
# root). Web code has no direct filesystem path to either -- mutations can
# only ever travel over the future sbox-cm AF_UNIX RPC.
ProtectSystem=strict
ReadWritePaths=@SBMON_STATE_ROOT@
ProtectHome=yes
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
# The monitor is a loopback CLIENT and loopback LISTENER: it needs AF_INET /
# AF_INET6 for 127.0.0.1:9091 and 127.0.0.1:9191, plus AF_UNIX for libc/NSS.
# Future sbox-cm RPC connects over AF_UNIX as well. This deliberately does
# NOT collapse to AF_UNIX-only -- that narrowing belongs to sbox-cm itself,
# which has no TCP surface at all. The two units keep separate address-family
# contracts on purpose.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
