# Operator-managed TLS reverse proxy for the P6 machine ingest (issue #67
# PR-6B, §7/§13). EXAMPLE ONLY -- reviewed, never installed automatically.
# The installer does not touch proxies; the operator owns TLS, DNS and this
# file. Contract invariants are asserted by the PR-6B lane:
#
#   * the EXACT ingest path is the only proxied location (no `location /`);
#   * upstream is loopback Monitor only -- root, login, recovery, sessions,
#     Incidents, static and every other Monitor path stay unexposed;
#   * all five X-Remote-Probe-* headers pass through untouched (nginx
#     forwards unknown headers by default; nothing rewrites them);
#   * the body reaches Monitor byte-exact and with a fixed Content-Length
#     (HTTP/1.1 upstream, no chunking, no buffering transformation);
#   * no Origin injection/rewrite and no redirects;
#   * TLS terminates on the external side only;
#   * coarse pre-auth bounds: body size, concurrency and request rate.
#
# Monitor keeps trusting the SOCKET PEER only: the proxy peer is loopback
# (127.0.0.1), which the whitelist must contain (webapp setup adds it). No
# X-Forwarded-For / X-Real-IP is read or set anywhere in Monitor.

# Include this file from nginx's http {} context. Supported baseline:
# nginx >= 1.18.0 with TLS support. HTTP/2 is optional and is not enabled
# here, so the example also validates before the 1.25.1 http2 directive.
limit_req_zone  $binary_remote_addr zone=probe_ingest:10m rate=20r/s;
limit_conn_zone $binary_remote_addr zone=probe_conns:10m;

server {
    listen 443 ssl;
    server_name probes.example.com;          # operator DNS name

    ssl_certificate     /etc/ssl/probes.example.com.fullchain.pem;
    ssl_certificate_key /etc/ssl/probes.example.com.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Coarse PRE-AUTH bounds owned by the proxy (issue #67 §8/§13). The
    # route cap itself (16 KiB, before JSON parse) is enforced again by
    # Monitor; this stops oversized junk before it reaches the app.
    client_max_body_size 16k;
    client_body_timeout  10s;

    # ONLY the exact ingest path is exposed. `location =` is an exact match:
    # /api/v1/remote-probes/ingest/extra, /api/v1/remote-probes and every
    # other path fall through to the 404 below.
    location = /api/v1/remote-probes/ingest {
        limit_req  zone=probe_ingest burst=240 nodelay;
        limit_conn probe_conns 20;

        proxy_pass http://127.0.0.1:9191;    # loopback Monitor, fixed port
        proxy_http_version 1.1;              # fixed Content-Length upstream
        proxy_set_header Connection "";
        proxy_request_buffering on;          # byte-exact body forwarding

        # Identity headers pass through UNTOUCHED -- never set, never
        # rewritten, never dropped:
        #   X-Remote-Probe-Id / X-Remote-Probe-Sent-Epoch /
        #   X-Remote-Probe-Run / X-Remote-Probe-Seq /
        #   X-Remote-Probe-Signature
        #
        # Do NOT add proxy_set_header lines for them; do NOT inject Origin
        # or forwarded headers -- Monitor trusts the socket peer only and
        # never reads X-Forwarded-For / X-Real-IP.

        proxy_redirect off;                  # never redirect the ingest call
        proxy_next_upstream off;             # one upstream, no retry shadow
    }

    # Everything else -- root, /login, /recovery, /api/v1/*, /static/*,
    # sessions, Incidents -- is NOT proxied. Answer 404 locally; never
    # forward, never redirect.
    location / {
        return 404;
    }
}
