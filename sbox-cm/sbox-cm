#!/usr/bin/env python3
"""sbox-cm privileged RPC core (E3 M1).

This process is the RPC Core half of the privileged execution plane. It owns
ONLY the transport and the connection boundary:

    AF_UNIX (systemd socket activation) / SO_PEERCRED / length-prefixed frame
    schema validation / dispatch / request_id replay cache
    connection-level audit

It never reads or writes sbconfig_server.json, never computes a credential
digest, and never sees a UUID or password. Every operation -- including the
read-only ones -- is dispatched to the root transaction worker
(`sbox-cm-ops`), which owns config.lock, the ledger, the tx journal, candidate
generation, commit_server_config and the privileged audit. There is exactly ONE
transaction engine in the system and it is not here.

Deadline contract (E3 M1 review B6): the helper enforces NO whole-op deadline.
The only enforced transport deadline is the 5s frame read. Every external
substep inside the worker (sing-box check, systemctl reload, health probe) is
bounded by its own timeout in the shared library, and the 120s figure is the
M2 CALLER's wait budget. This is deliberate: after a durable ledger intent has
been written the worker is NEVER killed -- there is no
`communicate(timeout=...)` anywhere in this file, and a client disconnect must
not abort a transaction that already entered mutation. So that one slow
mutation cannot starve status/list, each accepted connection is served by its
own daemon thread (config.lock still serializes the workers).

Subcommands:
    run                serve the RPC socket
    reconcile          run startup reconciliation once (also run at boot)
    mgmt-deactivate    root recovery CLI: clear the activation marker via the
                       maintenance verb (active_stale recovery; the ONLY path,
                       no manual rm, NOT reachable over the RPC socket)
"""

import errno
import json
import os
import re
import socket
import struct
import subprocess
import sys
import threading
import time
from collections import OrderedDict

RPC_VERSION = "e3-rpc/1"
MAX_FRAME = 65536
READ_TIMEOUT = 5.0
REPLAY_TTL = 600.0
REPLAY_MAX = 512

DEFAULT_SOCKET_PATH = "/run/sbox-cm/sbox-cm.sock"
DEFAULT_WORKER = "/usr/local/lib/sbox-cm/sbox-cm-ops"
DEFAULT_STATE_DIR = "/var/lib/sbox-cm"
ALLOWED_USER = "sboxweb"
RESERVED_NAME = "legacy"

OPS = {
    "management.status": {"required": (), "optional": (), "lock": False},
    "management.activate": {"required": (), "optional": ("actor",), "lock": True},
    "management.deactivate": {"required": (), "optional": (), "lock": True},
    "client.list": {"required": (), "optional": (), "lock": True},
    "client.add": {"required": ("name", "idempotency_key"),
                   "optional": ("actor",), "lock": True},
    "client.delete": {"required": ("name", "idempotency_key"),
                      "optional": ("actor",), "lock": True},
}
BASE_FIELDS = ("v", "request_id", "op")

NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,31}$")
REQID_RE = re.compile(r"^[A-Za-z0-9._-]{16,64}$")
KEY_RE = re.compile(r"^[A-Za-z0-9._:-]{16,128}$")
FP_RE = re.compile(r"^[0-9a-f]{16}$")


def sandbox():
    return os.environ.get("SBOX_CM_TEST_SANDBOX") == "1"


def log(msg):
    sys.stderr.write("[sbox-cm] %s\n" % msg)
    sys.stderr.flush()


class RpcError(Exception):
    def __init__(self, code, stage, retriable, detail):
        Exception.__init__(self, detail)
        self.code = code
        self.stage = stage
        self.retriable = retriable
        self.detail = detail


class FrameError(Exception):
    def __init__(self, code, stage):
        Exception.__init__(self, code)
        self.code = code
        self.stage = stage


# --------------------------------------------------------------------- config --
def socket_path():
    if sandbox():
        return os.environ.get("SBOX_CM_SOCKET", DEFAULT_SOCKET_PATH)
    return DEFAULT_SOCKET_PATH


def worker_path():
    if sandbox():
        return os.environ.get("SBOX_CM_WORKER", DEFAULT_WORKER)
    return DEFAULT_WORKER


def state_dir():
    if sandbox():
        return os.environ.get("SB_CM_STATE_DIR", DEFAULT_STATE_DIR)
    return DEFAULT_STATE_DIR


def allowed_uid():
    if sandbox() and os.environ.get("SBOX_CM_ALLOWED_UID"):
        return int(os.environ["SBOX_CM_ALLOWED_UID"])
    try:
        import pwd
        return pwd.getpwnam(ALLOWED_USER).pw_uid
    except (ImportError, KeyError):
        return None


def worker_env():
    if sandbox():
        env = dict(os.environ)
        env.setdefault("SBOX_CM_TEST_SANDBOX", "1")
        return env
    return {"PATH": "/usr/sbin:/usr/bin:/sbin:/bin", "LC_ALL": "C"}


# ------------------------------------------------------------------ state/audit --
def ensure_state_dir():
    for sub in ("", "/ledger", "/journal", "/audit"):
        path = state_dir() + sub
        try:
            os.makedirs(path, 0o700, exist_ok=True)
            os.chmod(path, 0o700)
        except OSError:
            return False
    # Production fail-closed ownership check (E3 M1 review B8): the root-only
    # ledger/audit must never end up readable by another owner. A pre-existing
    # directory owned by anyone else is chowned root:root and re-verified; if
    # that cannot be confirmed the daemon refuses to start. The unprivileged
    # test sandbox skips this.
    if not sandbox() and hasattr(os, "geteuid") and os.geteuid() == 0:
        for sub in ("", "/ledger", "/journal", "/audit"):
            path = state_dir() + sub
            try:
                st = os.stat(path)
                if st.st_uid != 0 or st.st_gid != 0:
                    os.chown(path, 0, 0)
                    st = os.stat(path)
                if st.st_uid != 0 or st.st_gid != 0:
                    log("state directory %s is not root-owned (fail-closed)" % path)
                    return False
            except OSError:
                return False
    return True


def fsync_path(path):
    """fsync a file (or a directory, to make a rename/entry durable).

    POSIX: directories are fsync-able and the durability contract is enforced
    in full. Non-POSIX development hosts cannot open a directory for fsync at
    all; sbox-cm is Linux/systemd-only in production, so the guard only keeps
    the test harness usable -- it never relaxes the Linux contract.
    """
    try:
        fd = os.open(path, os.O_RDONLY)
    except OSError:
        if os.name == "posix":
            raise
        return
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def audit_connection(outcome, stage, code, op=None, request_id=None):
    """One privileged audit record for a connection the worker never saw.

    The worker owns the audit for every request it was dispatched; the RPC core
    only records events that terminate before dispatch (peer reject, bad frame,
    timeout, schema error, dispatch failure). Same field set as the worker.
    """
    if not ensure_state_dir():
        return
    record = OrderedDict()
    record["v"] = 1
    record["audit_id"] = "conn:%d:%d" % (os.getpid(), _next_seq())
    record["ts"] = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    record["request_id"] = request_id
    record["op"] = op
    record["name"] = None
    record["outcome"] = outcome
    record["stage"] = stage
    record["key_fp"] = None
    record["generation"] = 0
    record["error"] = code
    record["actor"] = {"session_fp": None, "stepup_fp": None}
    record["source"] = "rpc"
    line = (json.dumps(record, separators=(",", ":")) + "\n").encode("utf-8")
    path = os.path.join(state_dir(), "audit", "cm.jsonl")
    try:
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
        try:
            os.write(fd, line)
            os.fsync(fd)
        finally:
            os.close(fd)
        fsync_path(os.path.join(state_dir(), "audit"))
    except OSError:
        log("audit append failed (continuing)")


_seq = [0]


def _next_seq():
    _seq[0] += 1
    return _seq[0]


# --------------------------------------------------------------------- worker --
def run_worker(op, args):
    """Run the transaction worker and return its result object.

    Deliberately no timeout: once the worker has written its durable ledger
    intent, killing it would leave the system in an unproven state. The 120s
    figure in the protocol is the CALLER's wait budget, not a kill timer.
    """
    try:
        proc = subprocess.Popen(
            [worker_path(), op],
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=None,
            env=worker_env(),
            close_fds=True,
        )
    except OSError as exc:
        raise RpcError("E_INTERNAL", "dispatch", False, "worker 启动失败: %s" % exc.errno)
    payload = json.dumps(args, separators=(",", ":")).encode("utf-8")
    out, _ = proc.communicate(payload)

    text = out.decode("utf-8", "replace") if out else ""
    result = None
    for line in text.splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            candidate = json.loads(line)
        except ValueError:
            continue
        if isinstance(candidate, dict) and "ok" in candidate:
            result = candidate
    if result is None:
        raise RpcError("E_INTERNAL", "dispatch", False, "worker 未返回协议结果")
    return result


def run_reconcile():
    """Run the worker's startup reconciliation (maintenance form, argv only)."""
    return run_maintenance("reconcile")


def run_maintenance(verb):
    """Run a root-only maintenance verb of the worker (argv only, never a
    request-driven op). `reconcile` runs at daemon startup; `mgmt-deactivate`
    is the one sanctioned active_stale recovery path."""
    try:
        proc = subprocess.Popen(
            [worker_path(), "--maintenance", verb],
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=None,
            env=worker_env(),
            close_fds=True,
        )
    except OSError as exc:
        raise RpcError("E_INTERNAL", verb, False, "worker 启动失败: %s" % exc.errno)
    out, _ = proc.communicate(b"")
    for line in (out or b"").decode("utf-8", "replace").splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            obj = json.loads(line)
        except ValueError:
            continue
        if isinstance(obj, dict) and "ok" in obj:
            return obj
    raise RpcError("E_INTERNAL", verb, False, "maintenance %s 未返回协议结果" % verb)


# ------------------------------------------------------------------- validate --
def validate_request(obj):
    if not isinstance(obj, dict):
        raise RpcError("E_SCHEMA", "parse", False, "请求不是 JSON 对象")

    op = obj.get("op")
    if not isinstance(op, str) or op not in OPS:
        raise RpcError("E_OP_UNKNOWN", "parse", False, "未知操作")

    spec = OPS[op]
    allowed = set(BASE_FIELDS) | set(spec["required"]) | set(spec["optional"])
    for key in obj:
        if key not in allowed:
            raise RpcError("E_SCHEMA", "parse", False, "未知字段: %s" % key)

    if obj.get("v") != RPC_VERSION:
        raise RpcError("E_SCHEMA", "parse", False, "协议版本不匹配")

    request_id = obj.get("request_id")
    if not isinstance(request_id, str) or not REQID_RE.match(request_id):
        raise RpcError("E_SCHEMA", "parse", False, "request_id 非法")

    for field in spec["required"]:
        if field not in obj:
            raise RpcError("E_SCHEMA", "parse", False, "缺少字段: %s" % field)

    args = {"request_id": request_id}

    if "name" in spec["required"]:
        name = obj.get("name")
        if not isinstance(name, str) or not NAME_RE.match(name):
            raise RpcError("E_SCHEMA", "parse", False, "name 非法")
        if name == RESERVED_NAME:
            raise RpcError("E_RESERVED_NAME", "parse", False, "%s 是保留名称" % RESERVED_NAME)
        args["name"] = name

    if "idempotency_key" in spec["required"]:
        key = obj.get("idempotency_key")
        if not isinstance(key, str) or not KEY_RE.match(key):
            raise RpcError("E_SCHEMA", "parse", False, "idempotency_key 非法")
        args["idempotency_key"] = key

    if "actor" in spec["optional"] and "actor" in obj:
        actor = obj["actor"]
        if not isinstance(actor, dict):
            raise RpcError("E_SCHEMA", "parse", False, "actor 必须是对象")
        for key in actor:
            if key not in ("session_fp", "stepup_fp"):
                raise RpcError("E_SCHEMA", "parse", False, "actor 含未知字段")
        norm = {}
        for key, value in actor.items():
            if not isinstance(value, str) or not FP_RE.match(value):
                raise RpcError("E_SCHEMA", "parse", False, "actor 指纹非法")
            norm[key] = value
        args["actor"] = norm

    return op, args


def ok_envelope(request_id, op, wres):
    env = OrderedDict()
    env["ok"] = True
    env["v"] = RPC_VERSION
    env["request_id"] = request_id
    env["op"] = op
    if wres.get("idempotency"):
        env["idempotency"] = wres["idempotency"]
    if wres.get("transaction"):
        env["transaction"] = wres["transaction"]
    env["warnings"] = wres.get("warnings") or []
    env["data"] = wres.get("data")
    return env


def err_envelope(request_id, op, code, stage, retriable, detail, backup=None):
    env = OrderedDict()
    env["ok"] = False
    env["v"] = RPC_VERSION
    env["request_id"] = request_id
    env["op"] = op
    env["error"] = OrderedDict(
        (("code", code), ("stage", stage), ("retriable", retriable),
         ("detail", detail), ("backup", backup)))
    return env


# --------------------------------------------------------------------- frames --
def recv_exact(conn, n):
    buf = b""
    while len(buf) < n:
        try:
            chunk = conn.recv(n - len(buf))
        except socket.timeout:
            raise FrameError("E_TIMEOUT", "parse")
        except OSError:
            raise FrameError("E_SCHEMA", "parse")
        if not chunk:
            raise FrameError("E_SCHEMA", "parse")
        buf += chunk
    return buf


def read_frame(conn):
    header = recv_exact(conn, 4)
    (length,) = struct.unpack(">I", header)
    if length == 0 or length > MAX_FRAME:
        raise FrameError("E_SCHEMA", "parse")
    body = recv_exact(conn, length)
    try:
        text = body.decode("utf-8")
    except UnicodeDecodeError:
        raise FrameError("E_SCHEMA", "parse")
    try:
        return json.loads(text)
    except ValueError:
        raise FrameError("E_SCHEMA", "parse")


def send_frame(conn, obj):
    body = json.dumps(obj, separators=(",", ":"), ensure_ascii=False).encode("utf-8")
    if len(body) > MAX_FRAME:
        body = json.dumps(
            {"ok": False, "v": RPC_VERSION, "request_id": None,
             "error": {"code": "E_INTERNAL", "stage": "done", "retriable": False,
                       "detail": "响应超过帧上限"}},
            separators=(",", ":")).encode("utf-8")
    try:
        conn.sendall(struct.pack(">I", len(body)) + body)
    except OSError:
        pass


# ----------------------------------------------------------------- replay cache --
_replay = OrderedDict()
_replay_lock = threading.Lock()


def replay_get(request_id):
    with _replay_lock:
        entry = _replay.get(request_id)
        if entry is None:
            return None
        ts, resp = entry
        if time.monotonic() - ts > REPLAY_TTL:
            del _replay[request_id]
            return None
        return resp


def replay_put(request_id, resp):
    with _replay_lock:
        _replay[request_id] = (time.monotonic(), resp)
        while len(_replay) > REPLAY_MAX:
            _replay.popitem(last=False)


# ------------------------------------------------------------------- peer auth --
def peer_uid(conn):
    if sandbox() and os.environ.get("SBOX_CM_TEST_PEER_UID"):
        return int(os.environ["SBOX_CM_TEST_PEER_UID"])
    try:
        raw = conn.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, struct.calcsize("3i"))
        _pid, uid, _gid = struct.unpack("3i", raw)
        return uid
    except (AttributeError, OSError):
        return None


def handle_connection(conn, allowed):
    request_id = None
    op = None
    try:
        peer = peer_uid(conn)
        if allowed is None or peer is None or peer != allowed:
            # root is rejected too: the only channel is the CLI/worker, never a
            # socket back door.
            audit_connection("rejected", "peer", "E_PEER_AUTH")
            send_frame(conn, err_envelope(None, None, "E_PEER_AUTH", "peer", False,
                                          "对端身份不被允许"))
            return
        conn.settimeout(READ_TIMEOUT)
        try:
            obj = read_frame(conn)
        except FrameError as exc:
            audit_connection("rejected", exc.stage, exc.code)
            return  # no protocol oracle for a malformed frame
        try:
            op, args = validate_request(obj)
        except RpcError as exc:
            request_id = obj.get("request_id") if isinstance(obj, dict) else None
            audit_connection("rejected", exc.stage, exc.code, op=op, request_id=request_id)
            send_frame(conn, err_envelope(request_id, op, exc.code, exc.stage,
                                          exc.retriable, exc.detail))
            return

        request_id = args["request_id"]
        cached = replay_get(request_id)
        if cached is not None:
            send_frame(conn, cached)
            return

        try:
            wres = run_worker(op, args)
        except RpcError as exc:
            # the worker never produced a protocol result -> it did not audit
            audit_connection("rejected", exc.stage, exc.code, op=op, request_id=request_id)
            send_frame(conn, err_envelope(request_id, op, exc.code, exc.stage,
                                          exc.retriable, exc.detail))
            return

        if wres.get("ok"):
            resp = ok_envelope(request_id, op, wres)
        else:
            resp = err_envelope(request_id, op, wres.get("code", "E_INTERNAL"),
                                wres.get("stage", "done"),
                                bool(wres.get("retriable", False)),
                                wres.get("detail", ""), wres.get("backup"))
        replay_put(request_id, resp)
        send_frame(conn, resp)
    finally:
        try:
            conn.close()
        except OSError:
            pass


# -------------------------------------------------------------------- listening --
def _is_stale_unix_socket(path):
    if not os.path.exists(path):
        return True
    if not os.path.isfile(path):
        return False
    st = os.lstat(path)
    if st.st_uid != 0:
        return False
    probe = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        probe.settimeout(0.5)
        probe.connect(path)
        return False
    except OSError as exc:
        return exc.errno in (errno.ECONNREFUSED, errno.ENOENT)
    finally:
        probe.close()


def bind_socket(path):
    directory = os.path.dirname(path)
    os.makedirs(directory, 0o755, exist_ok=True)
    try:
        os.chmod(directory, 0o755)
    except OSError:
        pass
    if not _is_stale_unix_socket(path):
        log("refusing to bind: %s exists and is not a stale root-owned socket" % path)
        return None
    if os.path.exists(path):
        os.unlink(path)
    srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    srv.bind(path)
    os.chmod(path, 0o660)
    if not sandbox():
        try:
            import grp
            gid = grp.getgrnam(ALLOWED_USER).gr_gid
            os.chown(path, 0, gid)
        except (ImportError, KeyError):
            log("refusing to bind: group %s missing" % ALLOWED_USER)
            srv.close()
            return None
    srv.listen(128)
    return srv


def acquire_listener():
    if not sandbox() and os.environ.get("LISTEN_PID") == str(os.getpid()):
        try:
            import socket as _socket
            fd = 3
            srv = _socket.socket(fileno=fd)
            log("using systemd socket activation (fd %d)" % fd)
            return srv
        except OSError as exc:
            log("socket activation fd unusable: %s" % exc)
            return None
    return bind_socket(socket_path())


# ----------------------------------------------------------------------- serve --
def cmd_run():
    if not ensure_state_dir():
        log("cannot prepare state directory")
        return 2

    allowed = allowed_uid()
    if allowed is None:
        log("allowed user %s does not exist: refusing every connection (fail-closed)"
            % ALLOWED_USER)

    if os.environ.get("SBOX_CM_SKIP_RECONCILE") != "1":
        try:
            res = run_reconcile()
        except RpcError as exc:
            log("startup reconciliation failed: %s" % exc.detail)
            return 2
        if not res.get("ok") or (res.get("data") or {}).get("degraded"):
            log("startup reconciliation left the helper degraded")
    else:
        log("SBOX_CM_SKIP_RECONCILE=1 (test-only): skipping reconciliation")

    srv = acquire_listener()
    if srv is None:
        return 2
    log("listening on %s" % socket_path())
    while True:
        try:
            conn, _ = srv.accept()
        except OSError as exc:
            if exc.errno == errno.EINTR:
                continue
            log("accept failed: %s" % exc)
            return 2
        # One daemon thread per connection: a slow (but never killed) mutation
        # worker must not stop status/list from being served. The workers
        # themselves are still serialized by config.lock inside the worker.
        worker = threading.Thread(target=handle_connection, args=(conn, allowed),
                                  daemon=True)
        worker.start()


# ------------------------------------------------------------------- CLI verbs --
def cmd_reconcile():
    res = run_reconcile()
    sys.stdout.write(json.dumps(res, ensure_ascii=False, indent=2) + "\n")
    return 0 if res.get("ok") else 1


def cmd_mgmt_deactivate():
    """Root recovery CLI: dispatches the worker's MAINTENANCE verb, which is
    deliberately NOT one of the six public RPC ops -- an active_stale marker
    must never be clearable through the RPC socket."""
    res = run_maintenance("mgmt-deactivate")
    sys.stdout.write(json.dumps(res, ensure_ascii=False, indent=2) + "\n")
    return 0 if res.get("ok") else 1


def usage():
    sys.stderr.write(
        "usage: sbox-cm {run|reconcile|mgmt-deactivate}\n")


def main(argv):
    if len(argv) < 2:
        usage()
        return 2
    command = argv[1]
    if command == "run":
        return cmd_run()
    if command == "reconcile":
        return cmd_reconcile()
    if command == "mgmt-deactivate":
        return cmd_mgmt_deactivate()
    usage()
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
